{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://math-tutor.local/schemas/learner-state.schema.json",
  "title": "Math Tutor Learner State",
  "type": "object",
  "required": [
    "learnerId",
    "placement",
    "skillStates",
    "decomposition",
    "persona",
    "gamification"
  ],
  "properties": {
    "learnerId": {
      "type": "string"
    },
    "placement": {
      "type": "object",
      "required": [
        "recommendedBand",
        "confidence",
        "updatedAt"
      ],
      "properties": {
        "recommendedBand": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 12
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "domainBands": {
          "type": "object",
          "additionalProperties": {
            "type": "number"
          }
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": false
    },
    "skillStates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "topicId",
          "state",
          "mastery",
          "independence",
          "retention",
          "supportLevel"
        ],
        "properties": {
          "topicId": {
            "type": "string"
          },
          "state": {
            "type": "string",
            "enum": [
              "unseen",
              "observed",
              "developing",
              "provisional_mastery",
              "reliable_mastery",
              "fragile",
              "needs_remediation"
            ]
          },
          "mastery": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "independence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "retention": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "supportLevel": {
            "type": "integer",
            "minimum": 0,
            "maximum": 6
          },
          "misconceptionTags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "lastAttemptAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          }
        },
        "additionalProperties": false
      }
    },
    "decomposition": {
      "type": "object",
      "additionalProperties": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      }
    },
    "persona": {
      "type": "object",
      "properties": {
        "explicitPreferences": {
          "type": "object"
        },
        "hypotheses": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "currentSessionState": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "gamification": {
      "type": "object",
      "required": [
        "xp",
        "achievementIds"
      ],
      "properties": {
        "xp": {
          "type": "integer",
          "minimum": 0
        },
        "achievementIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
