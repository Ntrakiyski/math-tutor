# Math Tutor MVP — copy to .env and fill the three required credentials.
# Never commit .env.

# ---------------------------------------------------------------------------
# Required: Eve model access
# Eve supports the Vercel AI Gateway with string model IDs.
# ---------------------------------------------------------------------------
AI_GATEWAY_API_KEY=
AI_MODEL=anthropic/claude-sonnet-5

# ---------------------------------------------------------------------------
# Required: InsForge runtime persistence
# Find the base URL and anon key in the InsForge project installation/API Keys.
# The browser does not receive these values; only the agent/backend uses them.
# ---------------------------------------------------------------------------
INSFORGE_BASE_URL=https://your-project.insforge.app
INSFORGE_ANON_KEY=

# Optional: provisioning only. Never expose to the browser.
# Used by the developer/CLI for schema creation and administrative setup.
INSFORGE_ADMIN_API_KEY=

# ---------------------------------------------------------------------------
# Agent service
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=3001
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Fixed MVP product settings
# ---------------------------------------------------------------------------
PRIMARY_LEARNER_ID=learner_sister
APP_LOCALE=bg-BG
CONTENT_DATA_DIR=./data/mvp
CONTENT_VERSION=0.1.0
DATA_BACKEND=insforge

# Eve persists local workflow run state here by default.
# Mount this directory when the agent runs in a container:
# .eve/.workflow-data

# ---------------------------------------------------------------------------
# Web application — values prefixed with VITE_ are safe browser configuration.
# ---------------------------------------------------------------------------
VITE_AGENT_BASE_URL=http://localhost:3001
VITE_APP_LOCALE=bg-BG
VITE_PRIMARY_LEARNER_ID=learner_sister
VITE_ENABLE_ADMIN=true

# ---------------------------------------------------------------------------
# Deferred/optional capabilities
# ---------------------------------------------------------------------------
ENABLE_MANIM=false
MANIM_RENDERER_URL=http://localhost:8000

# CopilotKit is not required for the primary implementation.
# Set only if the documented Eve integration spike fails and the fallback is used.
COPILOTKIT_PUBLIC_API_KEY=
